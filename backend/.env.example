PORT=5000
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
# Required. Local: mongodb://127.0.0.1:27017/hospitalsos  Atlas: mongodb+srv://...
MONGODB_URI=
# Comma-separated list of web apps allowed to call the API (hospital portal, admin panel)
# Production example: https://hospitalsos-web.onrender.com
CLIENT_ORIGIN=http://localhost:5173
# Seed demo data automatically when the database is empty (must be true to seed in production)
AUTO_SEED=true
# Used in approval emails so hospitals can open the portal
# APP_URL=https://hospitalsos-web.onrender.com
# Admin panel / review APIs: send header X-Admin-Key
# Local review UI: http://localhost:5173/admin/hospitals  (dev default key: dev-admin-key)
ADMIN_API_KEY=change-me
# Optional SMTP. If unset, approval and rejection emails are printed in the API log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Shafi SOS <noreply@yourdomain.com>
# Cookie settings when the API and web apps are on different domains (defaults: secure + none in production)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
